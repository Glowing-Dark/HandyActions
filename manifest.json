{
  "manifest_version": 3,
  "name": "Handy Actions — Visual Web Automation & Page Buttons",
  "version": "1.0.0",
  "description": "Pick any webpage element, run click/fill/type/wait sequences, and inject custom action buttons per website or wildcard URL from the side panel.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Handy Actions",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": [
    "sidePanel",
    "tabs",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "shared/url-matcher.js",
        "shared/storage.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
